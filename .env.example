# PostgreSQL connection string.
# Copy this file to .env.local and fill in real values. Never commit .env.local.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE_NAME"

# Used to sign/verify session and password-reset tokens. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""

# Base URL of the app, used to build links in emails (e.g. password reset).
APP_URL="http://localhost:3000"
